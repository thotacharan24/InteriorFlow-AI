{
  "name": "InteriorFlow deadline monitor",
  "nodes": [
    {
      "id": "b7d19ed3-2e0e-4757-ba37-5a5c8a6d48b7",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "acf0d4b4-1582-4422-852b-9faf9105dcd9",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "0a23b925-599d-437e-8bb9-760800917903",
      "name": "Monitor deadlines",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5000/api/monitor",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-InteriorFlow-Key",
              "value": "={{ $env.N8N_API_KEY }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Monitor deadlines",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily Schedule": {
      "main": [
        [
          {
            "node": "Monitor deadlines",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}